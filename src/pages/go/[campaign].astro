---
// These two social entry points use registered Airbridge links. Do not use them
// as paid-ad destinations: regular landing pages never auto-redirect.
const entries = {
  'x-ja': 'https://abr.ge/mqzo6ok',
  'x-ja-post': 'https://abr.ge/4fxjp3q',
};
export function getStaticPaths() {
  return [{ params: { campaign: 'x-ja' } }, { params: { campaign: 'x-ja-post' } }];
}
const destination = entries[Astro.params.campaign];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href="https://kbap.site/ja/" />
  <title>K-Bap — 韓国語メニュー翻訳</title>
  <meta name="description" content="K-Bapで韓国のメニューをあなたの言語に。" />
  <meta property="og:title" content="K-Bap — 韓国語メニュー翻訳" />
  <meta property="og:description" content="K-Bapで韓国のメニューをあなたの言語に。" />
  <meta property="og:image" content="https://kbap.site/assets/brand/og-cover.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <noscript><meta http-equiv="refresh" content={`0;url=${destination}`} /></noscript>
</head>
<body>
  <p><a href={destination}>K-Bapへ進む</a></p>
  <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
</body>
</html>
