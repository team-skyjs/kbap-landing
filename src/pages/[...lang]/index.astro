---
import Base from '../../layouts/Base.astro';
import Badges from '../../components/Badges.astro';
import { LANGS, ENDONYM, langParam } from '../../i18n/langs.js';
import { t as dict } from '../../i18n/t.js';
import { HERO_MENU, HERO_CYCLE, SPICE_DISHES, ALLERGENS, ALLERGENS_CAPTURED, FLAGS, LANG_FLAG, dishName } from '../../data/dishes.js';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang: langParam(lang) }, props: { lang } }));
}

const { lang } = Astro.props;
const t = dict(lang);
// Korean readers already read the menu, so their hero shows the English morph (D-24).
const boardLang = lang === 'ko' ? 'en' : lang;
const cycle = [boardLang, ...HERO_CYCLE.filter((l) => l !== boardLang)];
const RISK = { safe: 'risk.safe', caution: 'risk.caution', danger: 'risk.danger' };
const flagName = (code: string) => new Intl.DisplayNames([lang], { type: 'region' }).of(code.toUpperCase());
const cap = (name: string) => `/assets/cap/${name}.webp`;
// Captures are 1206×2622 screens shown at 640px.
const CAP_W = 640, CAP_H = 1391;

// Each language's own "View in …" line, for the root page's suggestion link (app.js).
const suggest = Object.fromEntries(LANGS.filter((l) => l !== 'en').map((l) => [l, dict(l)('langSuggest')]));
---
<Base lang={lang} path="/">
  {lang === 'en' && <a class="lang-suggest" hidden data-suggest={JSON.stringify(suggest)}></a>}

  <main>
    <!-- ───────────── hero ───────────── -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1><span>{t('hero.h1')}</span> <span class="accent">{t('hero.h2')}</span></h1>
          <p class="lede">{t('hero.sub')}</p>
          <div class="hero-cta">
            <Badges t={t} />
            <div class="hero-note">
              <p class="free">{t('hero.free')}</p>
              <p>{t('hero.freeSub')}</p>
            </div>
          </div>
          <p class="note-mobile">{t('hero.note')}</p>
        </div>

        <div class="hero-stage" aria-hidden="true">
          <div class="rail">
            {cycle.map((l, i) => <span class="chip" data-lang={l} lang={l} aria-pressed={i === 0 ? 'true' : 'false'}>{ENDONYM[l]}</span>)}
          </div>
          <p class="morph-toast"><span lang="ko">한국어</span><span class="chev">›</span><b lang={boardLang}>{ENDONYM[boardLang]}</b></p>
          <div class="board" data-names={JSON.stringify(Object.fromEntries(cycle.map((l) => [l, HERO_MENU.map((d) => dishName(d, l))])))}>
            <p class="board-head"><b lang="ko">메 뉴</b><span>{t('hero.menu')}</span></p>
            <ol>
              {HERO_MENU.map((d, i) => (
                <li style={`--i:${i}`}>
                  <span class="ko-line"><span lang="ko">{d.ko}</span><span class="price">{d.price}원</span></span>
                  <span class="tr-line">
                    <span class="names"><b class="name" lang={boardLang}>{dishName(d, boardLang)}</b><small lang="ko">{d.ko}</small></span>
                    <img class="dot" src={`/assets/icons/risk-dot-${d.verdict}.svg`} alt="" width="18" height="18">
                  </span>
                </li>
              ))}
            </ol>
            <i class="beam"></i>
          </div>
          <div class="popover">
            <img src="/assets/icons/risk-dot-caution.svg" alt="" width="22" height="22">
            <span><b>{t('hero.popTitle')}</b><small>{t('hero.popBody')}</small></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────── read it ───────────── -->
    <section class="chapter alt" id="read">
      <div class="wrap">
        <header class="ch-head">
          <p class="eyebrow">{t('read.eyebrow')}</p>
          <h2>{t('read.title')}</h2>
          <p>{t('read.sub')}</p>
        </header>

        <div class="step">
          <div class="step-text">
            <h3>{t('lang.title')}</h3>
            <p>{t('lang.body')}</p>
            <p class="hint">{t('lang.hint')}</p>
          </div>
          <div class="step-demo two">
            <div class="demo" data-demo="lang">
              <div class="chips scroll" role="group" aria-label={t('lang.hint')}>
                {[lang, ...LANGS.filter((l) => l !== lang)].map((l) => (
                  <button type="button" class="chip" lang={l} data-src={cap(`scan-result-list-${l}`)} aria-pressed={l === lang ? 'true' : 'false'}>{ENDONYM[l]}</button>
                ))}
              </div>
              <div class="shot phone" style="--top:.03">
                <img src={cap(`scan-result-list-${lang}`)} alt={t('lang.alt')} width={CAP_W} height={CAP_H} loading="lazy" decoding="async">
              </div>
            </div>
            <div class="shot phone desk-only" style="--top:0">
              <img src={cap('detail-en')} alt={t('detail.alt')} width={CAP_W} height={CAP_H} loading="lazy" decoding="async">
            </div>
          </div>
        </div>

        <div class="step">
          <div class="step-text">
            <h3>{t('photos.title')}</h3>
            <p>{t('photos.body')}</p>
            <p class="hint">{t('photos.hint')}</p>
          </div>
          <div class="step-demo">
            <div class="ba" data-demo="ba" style="--pos:50%">
              <img src={cap('scan-result-original-en')} alt={t('photos.alt')} width={CAP_W} height={CAP_H} loading="lazy" decoding="async">
              <div class="ba-after"><img src={cap('scan-result-list-en')} alt="" width={CAP_W} height={CAP_H} loading="lazy" decoding="async"></div>
              <span class="ba-tag before">{t('photos.before')}</span>
              <span class="ba-tag after">{t('photos.after')}</span>
              <span class="ba-knob" aria-hidden="true"></span>
              <input type="range" min="0" max="100" value="50" aria-label={t('photos.hint')}>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────── eat safely ───────────── -->
    <section class="chapter" id="eat">
      <div class="wrap">
        <header class="ch-head">
          <p class="eyebrow">{t('eat.eyebrow')}</p>
          <h2>{t('eat.title')}</h2>
          <p>{t('eat.sub')}</p>
        </header>

        <div class="step">
          <div class="step-text">
            <h3>{t('allergy.title')}</h3>
            <p>{t('allergy.body')}</p>
            <p class="hint">{t('allergy.hint')}</p>
          </div>
          <div class="step-demo two">
            <div class="demo" data-demo="allergy" data-on={cap('scan-result-risk-shrimp-soy-en')} data-off={cap('scan-result-risk-none-en')}>
              <div class="chips wrapy" role="group" aria-label={t('allergy.hint')}>
                {ALLERGENS.map((a) => (
                  <button type="button" class="chip" data-captured={ALLERGENS_CAPTURED.includes(a) ? '' : undefined} aria-pressed={ALLERGENS_CAPTURED.includes(a) ? 'true' : 'false'}>{t(`ingredients.${a}`)}</button>
                ))}
              </div>
              <div class="shot phone" style="--top:.03">
                <img src={cap('scan-result-risk-shrimp-soy-en')} alt={t('allergy.alt')} width={CAP_W} height={CAP_H} loading="lazy" decoding="async">
              </div>
            </div>
            <div class="demo hidden-demo">
              <p class="callout"><img src="/assets/icons/risk-dot-caution.svg" alt="" width="16" height="16">{t('hidden.label')}</p>
              <div class="shot bottom">
                <img src={cap('detail-ingredient-sheet-en')} alt={t('hidden.alt')} width={CAP_W} height={CAP_H} loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>

        <div class="step">
          <div class="step-text">
            <h3>{t('spice.title')}</h3>
            <p>{t('spice.body')}</p>
            <p class="hint">{t('spice.hint')}</p>
          </div>
          <div class="step-demo">
            <div class="card spice" data-demo="spice">
              <p class="spice-head"><span>{t('spice.gauge')}</span><b data-band>{t('spice.band.2')}</b></p>
              <div class="gauge" style="--v:2">
                <input type="range" min="0" max="4" value="2" step="1" aria-label={t('spice.gauge')}
                       data-bands={JSON.stringify([0, 1, 2, 3, 4].map((i) => t(`spice.band.${i}`)))}>
                <ol class="stops">{[0, 1, 2, 3, 4].map((i) => <li>{t(`spice.band.${i}`)}</li>)}</ol>
              </div>
              <ul class="tiles">
                {SPICE_DISHES.map((d) => (
                  <li data-spice={d.spice}>
                    <img src={`/assets/food/${d.img}.webp`} alt="" width="480" height="320" loading="lazy" decoding="async">
                    <b lang={d.name[lang] ? lang : 'en'}>{dishName(d, lang)}</b>
                    <small lang="ko">{d.ko}</small>
                    <span class="peppers" role="img" aria-label={t(`spice.band.${d.spice}`)}>
                      {[0, 1, 2, 3].map((k) => <img src={`/assets/icons/pepper-${k < d.spice ? 'on' : 'off'}.svg`} alt="" width="12" height="12">)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────── trust it ───────────── -->
    <section class="chapter alt" id="trust">
      <div class="wrap">
        <header class="ch-head">
          <p class="eyebrow">{t('trust.eyebrow')}</p>
          <h2>{t('trust.title')}</h2>
          <p>{t('trust.sub')}</p>
        </header>

        <div class="step">
          <div class="step-text">
            <h3>{t('reviews.title')}</h3>
            <p>{t('reviews.body')}</p>
          </div>
          <div class="step-demo">
            <div class="demo">
              <!-- ponytail: display only. The filtered capture is an empty state on dev data; make these buttons once prod reviews are captured. -->
              <ul class="chips scroll flags">
                {[LANG_FLAG[lang], ...FLAGS.filter((f) => f !== LANG_FLAG[lang])].slice(0, 6).map((f, i) => (
                  <li class={`chip${i === 0 ? ' on' : ''}`}><img src={`/assets/flags/${f}.svg`} alt="" width="18" height="14">{flagName(f)}</li>
                ))}
              </ul>
              <div class="shot phone short" style="--top:.03">
                <img src={cap('reviews-nat-off-en')} alt={t('reviews.alt')} width={CAP_W} height={CAP_H} loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────── order & share ───────────── -->
    <section class="chapter" id="order">
      <div class="wrap">
        <header class="ch-head">
          <p class="eyebrow">{t('order.eyebrow')}</p>
          <h2>{t('order.title')}</h2>
          <p>{t('order.sub')}</p>
        </header>

        <div class="step">
          <div class="step-text">
            <h3>{t('orderf.title')}</h3>
            <p>{t('orderf.body')}</p>
            <p class="hint">{t('orderf.hint')}</p>
          </div>
          <div class="step-demo">
            <div class="demo order-demo" data-demo="order">
              <div class="seg" role="group">
                <button type="button" aria-pressed="true" data-src={cap('order-cart-en')} data-alt={t('orderf.altYours')} data-top=".17">{t('orderf.yours')}</button>
                <button type="button" aria-pressed="false" data-src={cap('order-card-staff-en')} data-alt={t('orderf.altStaff')} data-top=".3">{t('orderf.staff')}</button>
              </div>
              <div class="shot phone" style="--top:.17">
                <img src={cap('order-cart-en')} alt={t('orderf.altYours')} width={CAP_W} height={CAP_H} loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>

        <!-- ponytail: copy only until the story-card capture exists (needs a saved order, QA). -->
        <div class="step">
          <div class="step-text">
            <h3>{t('share.title')}</h3>
            <p>{t('share.body')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────── final CTA ───────────── -->
    <section class="cta">
      <div class="wrap">
        <img class="cta-icon" src="/assets/brand/icon.svg" alt="" width="88" height="88" loading="lazy">
        <h2>{t('cta.title')}</h2>
        <p>{t('cta.sub')}</p>
        <Badges t={t} />
      </div>
    </section>
  </main>

  <script>
    import '../../scripts/home.js';
  </script>
</Base>
