---
// Official store badges. Hrefs are rewritten by app.js (homepage campaigns, iOS itms-apps escape).
const { t } = Astro.props;
---
<div class="badges">
  <a class="badge badge-apple" data-store="ios" href="https://apps.apple.com/app/apple-store/id6788635067?pt=128938928&ct=homepage&mt=8">
    <img src="/assets/badges/app-store-black.svg" alt={t('store.appleAlt')} width="156" height="52">
  </a>
  <a class="badge badge-play" data-store="android" href="https://play.google.com/store/apps/details?id=com.rocher.kbap&referrer=utm_source%3Dhomepage%26utm_medium%3Dwebsite%26utm_campaign%3Dhomepage">
    <img src="/assets/badges/google-play.png" alt={t('store.playAlt')} width="199" height="77">
  </a>
</div>
