---
import '../styles.css';
import { LANGS, ENDONYM, localePath } from '../i18n/langs.js';
import { t as dict } from '../i18n/t.js';
import { posts, releases, draftPreview } from '../content/posts.js';

interface Props {
  lang: string;
  /** Path without the language prefix, e.g. "/" or "/blog/hello/". */
  path: string;
  title?: string;
  ogType?: 'website' | 'article';
  description?: string;
  /** Languages this exact page exists in. Only these get hreflang links. */
  alternates?: string[];
}

const { lang, path, alternates = LANGS } = Astro.props;
const t = dict(lang);
const plain = dict(lang, { plain: true });   // meta tags: no phrase marks
const title = Astro.props.title ?? plain('meta.title');
const description = Astro.props.description ?? plain('meta.description');
const site = Astro.site!.origin;
const url = (l: string) => site + localePath(l, path);
const og = `${site}/assets/brand/og-cover.jpg`;
const home = localePath(lang, '/');

// Links only point at pages that exist: no blog in your language → the English one.
const blogLangs = new Set((await posts()).map((p) => p.lang));
const blogHref = blogLangs.has(lang) ? localePath(lang, '/blog/') : blogLangs.has('en') ? '/blog/' : null;
const changelogHref = (await releases()).length > 0 ? '/changelog/' : null;

// Pretendard covers Latin, Hangul and Cyrillic; these scripts get their Noto face (D-24 tokens).
const NOTO = { ja: 'Noto+Sans+JP', 'zh-Hans': 'Noto+Sans+SC', 'zh-Hant': 'Noto+Sans+TC', th: 'Noto+Sans+Thai' };
const noto = NOTO[lang] && `https://fonts.googleapis.com/css2?family=${NOTO[lang]}:wght@400;500;600;700&display=swap`;
const APP_STORE = 'https://apps.apple.com/app/apple-store/id6788635067?pt=128938928&ct=homepage&mt=8';
// Header language button on phones: room for a short label only.
const SHORT = { en: 'EN', ko: '한국어', ja: '日本語', 'zh-Hans': '简体', 'zh-Hant': '繁體', es: 'ES', id: 'ID', ru: 'RU', th: 'ไทย', vi: 'VI' };
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{draftPreview && <meta name="robots" content="noindex, nofollow, noarchive">}
<meta name="theme-color" content="#FFFFFF">
<link rel="canonical" href={url(lang)}>
{alternates.map((l) => <link rel="alternate" hreflang={l} href={url(l)}>)}
{alternates.includes('en') && <link rel="alternate" hreflang="x-default" href={url('en')}>}
<link rel="icon" href="/assets/brand/icon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/brand/icon.webp" type="image/webp">
<link rel="apple-touch-icon" href="/assets/brand/icon.webp">
<link rel="sitemap" href="/sitemap-index.xml">

<meta property="og:type" content={Astro.props.ogType ?? 'website'}>
<meta property="og:url" content={url(lang)}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content={lang.replace('-', '_')}>
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<!-- Pretendard is the app's and the ad creative's typeface. Loaded off the
     critical path so a slow CDN can't hold up first paint on paid traffic. -->
<link rel="preload" as="style" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"></noscript>
{noto && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>}
{/* same non-blocking pattern as Pretendard: Noto CSS was render-blocking (ja LCP 10s) */}
{noto && <link rel="preload" as="style" href={noto} onload="this.onload=null;this.rel='stylesheet'">}
{noto && <noscript><link rel="stylesheet" href={noto}></noscript>}

<!-- Meta Pixel: no pixel exists on the ad account (checked 2026-09-21). When one is
     created, the base code goes here. Nothing is loaded until then. -->
<slot name="head" />
</head>
<body>

<header class="nav">
  <div class="wrap nav-row">
    <a href={home} class="logo" aria-label="K-Bap"><img src="/assets/brand/wordmark.svg" alt="K-Bap" width="72" height="23"></a>
    <nav class="nav-links" aria-label="Site">
      <a href={`${home}#read`}>{t('nav.features')}</a>
      {blogHref && <a href={blogHref}>{t('nav.blog')}</a>}
      {changelogHref && <a href={changelogHref}>{t('nav.changelog')}</a>}
    </nav>
    <div class="nav-right">
      <details class="lang-select nav-lang">
        <!-- Name = the visible label + ", Language" (display:none span drops out), so it always starts with what's on screen. -->
        <summary><span class="full">{ENDONYM[lang]}</span><span class="short" lang={lang}>{SHORT[lang]}</span><span class="sr">, {plain('footer.language')}</span></summary>
        <ul>{alternates.map((l) => <li><a href={localePath(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{ENDONYM[l]}</a></li>)}</ul>
      </details>
      <!-- .pill: app.js points this at Play on Android. -->
      <a class="btn btn-sm pill" data-store="ios" href={APP_STORE}>{t('nav.getApp')}</a>
    </div>
  </div>
</header>

<slot />

<footer class="footer">
  <div class="wrap">
    <div class="footer-cols">
      <div class="footer-brand">
        <img src="/assets/brand/wordmark.svg" alt="K-Bap" width="72" height="23">
        <p>{t('footer.tagline')}</p>
      </div>
      <div class="footer-col">
        <h2>{t('footer.product')}</h2>
        {blogHref && <a href={blogHref}>{t('nav.blog')}</a>}
        {changelogHref && <a href={changelogHref}>{t('nav.changelog')}</a>}
        <a data-store="ios" href={APP_STORE}>App Store</a>
      </div>
      <div class="footer-col">
        <h2>{t('footer.legal')}</h2>
        <a href="https://team-skyjs.github.io/kbap-legal/privacy-policy.html">{t('footer.privacy')}</a>
        <a href="https://team-skyjs.github.io/kbap-legal/terms-of-service.html">{t('footer.terms')}</a>
        <a href="https://team-skyjs.github.io/kbap-legal/safety.html">{t('footer.safety')}</a>
      </div>
      <div class="footer-col">
        <h2>{t('footer.contact')}</h2>
        <a href="mailto:teamskyjs@gmail.com">teamskyjs@gmail.com</a>
        <details class="lang-select up">
          <summary>{ENDONYM[lang]}<span class="sr">, {plain('footer.language')}</span></summary>
          <ul>{alternates.map((l) => <li><a href={localePath(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{ENDONYM[l]}</a></li>)}</ul>
        </details>
      </div>
    </div>
    <div class="fine">
      <p>{t('footer.disclaimer')}</p>
      <p>{t('footer.copyright')}</p>
    </div>
  </div>
</footer>

<script is:inline src="/app.js"></script>
<script>import "../scripts/x-attribution.js";</script>
</body>
</html>
